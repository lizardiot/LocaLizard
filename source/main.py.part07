        except Exception:
            # Never silently discard changes, but release mount lock; leave work dir for recovery.
            try:
                self.run_cmd(["dism.exe", f"/Unmount-Image", f"/MountDir:{mount}", "/Discard"], check=False, respect_cancel=False)
            except Exception: pass
            if mount in self.mounts: self.mounts.remove(mount)
            raise

    def import_donor_iso_packages(self, image_plan: list[tuple[Path, dict]]) -> list[Path]:
        """Import standalone Russian CABs from an optional localized Windows ISO.

        The donor ISO is only a package source. Its install.wim/install.esd is inspected
        for build-family and architecture compatibility, but it never replaces the target
        image and the selected donor ISO is never modified.
        """
        self.donor_setup_files = []
        donor_iso = self.cfg.donor_iso
        if not donor_iso:
            return []
        if not donor_iso.is_file():
            raise RuntimeError(f"ISO-источник русского языка не найден: {donor_iso}")
        if donor_iso.resolve() in (self.cfg.source_iso.resolve(), self.cfg.output_iso.resolve()):
            raise RuntimeError("ISO-источник русского языка должен отличаться от входного и выходного ISO.")
        if not self.work:
            raise RuntimeError("Внутренняя ошибка: рабочая папка ещё не создана.")

        iso_q = str(donor_iso).replace("'", "''")
        imported: list[Path] = []
        try:
            script = f"$img=Mount-DiskImage -ImagePath '{iso_q}' -PassThru; $vol=$img | Get-Volume; if(-not $vol.DriveLetter){{throw 'ISO-источник не получил букву диска'}}; $vol.DriveLetter"
            cp = self.powershell(script)
            m = re.search(r"([A-Z]):?\s*$", (cp.stdout or "").strip(), re.I)
            if not m:
                raise RuntimeError("Не удалось смонтировать ISO-источник русского языка.")
            root = Path(m.group(1).upper() + ":\\")
            sources = root / "sources"
            donor_images = sorted(list(sources.glob("install*.wim")) + list(sources.glob("install*.esd")))
            if not donor_images:
                self.log("В русском ISO не найден install.wim/install.esd; автоматическое извлечение языковых пакетов пропущено.")
                return []

            donor_infos: list[dict] = []
            for image in donor_images:
                try:
                    donor_infos.extend(self.image_info(image))
                except Exception as exc:
                    self.log(f"Не удалось прочитать индексы русского ISO {image.name}: {exc}")
            target_infos = [info for _, info in image_plan]
            compatible_targets = [
                target for target in target_infos
                if any(
                    self.build_family(target.get("version", "")) is not None
                    and self.build_family(target.get("version", "")) == self.build_family(donor.get("version", ""))
                    and self.arch_token(target.get("architecture", "")) == self.arch_token(donor.get("architecture", ""))
                    for donor in donor_infos
                )
            ]
            if not donor_infos or not compatible_targets:
                donor_summary = ", ".join(
                    f'{d.get("version", "?")}/{d.get("architecture", "?")}' for d in donor_infos[:8]
                ) or "версия/архитектура не определены"
                self.log(
                    "Русский ISO не признан совместимым источником пакетов по ветке сборки и архитектуре. "
                    f"Данные источника: {donor_summary}. Пакеты не будут смешиваться с целевым образом."
                )
                return []

            destination_root = self.work / "donor_iso_packages"
            copied_names: set[str] = set()
            candidates = self.find_packages(root)
            for package in candidates:
                self.check_cancel()
                kind = self.classify_donor_package(package)
                if not kind:
                    continue
                if kind == "client_lp" and not any(self.locate_ru_lp(info, [package]) for info in compatible_targets):
                    continue
                relative = str(package.relative_to(root))
                if kind == "setup":
                    dest_dir = destination_root / "setup"
                    dest = dest_dir / package.name
                    if package.name.lower() in copied_names:
                        continue
                    copied_names.add(package.name.lower())
                else:
                    dest_dir = destination_root / kind
                    prefix = hashlib.sha1(relative.encode("utf-8", "replace")).hexdigest()[:8]
                    dest = dest_dir / f"{prefix}_{package.name}"
                dest_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(package, dest)
                if kind == "setup":
                    self.donor_setup_files.append(dest)
                else:
                    imported.append(dest)
                self.log(f"Найден пакет в русском ISO ({kind}): {relative}")

            base_packs = [p for p in imported if self.classify_donor_package(p) == "client_lp"]
            self.log(
                f"Проверка русского ISO завершена: импортировано самостоятельных языковых CAB/FOD — {len(imported)}, "
                f"пакетов Setup — {len(self.donor_setup_files)}."
            )
            if not base_packs:
                self.log(
                    "В русском ISO не обнаружен отдельный совместимый Client Language Pack CAB. "
                    "Если русский язык уже встроен в install.wim/install.esd, DISM не извлекает из него "
                    "готовый базовый CAB автоматически; будет предпринят поиск через UUP Dump."
                )
            return imported
        finally:
            self.powershell(f"Dismount-DiskImage -ImagePath '{iso_q}'", check=False, respect_cancel=False)

    def process_setup_wim(self, media: Path, pack_files: list[Path]) -> bool:
        boot = media / "sources" / "boot.wim"
        if not self.cfg.process_setup:
            self.log("Локализация Setup/WinPE отключена пользователем.")
            return False
        # Find ADK WinPE Russian language files. We only add them if present and never mix OS language CAB blindly.
        target_arch = "x64"
        for target_image in (media / "sources" / "install.wim", media / "sources" / "install.esd"):
            if target_image.is_file():
                try:
                    target_infos = self.image_info(target_image)
                    if target_infos:
                        target_arch = self.arch_token(target_infos[0].get("architecture", "x64"))
                except Exception as exc:
                    self.log(f"Не удалось определить архитектуру Setup/WinPE: {exc}")
                break
        kit_arch = "amd64" if target_arch == "x64" else target_arch
        kits = Path(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")) / "Windows Kits" / "10" / "Assessment and Deployment Kit" / "Windows Preinstallation Environment" / kit_arch / "WinPE_OCs" / "ru-ru"
        donor_by_name = {p.name.lower(): p for p in self.donor_setup_files}
        expected = []
        for name in ("lp.cab", "WinPE-Setup_ru-ru.cab", "WinPE-Setup-Client_ru-ru.cab"):
            local = kits / name
            expected.append(local if local.is_file() else donor_by_name.get(name.lower(), local))
        expected += sorted(kits.glob("WinPE-Rejuv_ru-ru.cab"))
        expected += [
            p for p in self.donor_setup_files
            if p.name.lower().startswith("winpe-rejuv_ru-ru") and p not in expected
        ]
        missing = [p.name for p in expected[:3] if not p.is_file()]
        if missing:
            self.log("Для локализации Setup не хватает ADK-пакетов: " + ", ".join(missing))
            return False
        # For setup media index 2 is Windows Setup; index 1 is Windows PE. Add packages to index 2 only.
        mount = self.work / "mount_boot_2"
        mount.mkdir(exist_ok=True)
        self.mounts.append(mount)
        self.run_cmd(["dism.exe", "/Mount-Image", f"/ImageFile:{boot}", "/Index:2", f"/MountDir:{mount}", "/CheckIntegrity"])
        try:
            for p in expected:
                if p.exists(): self.run_cmd(["dism.exe", f"/Image:{mount}", "/Add-Package", f"/PackagePath:{p}", "/NoRestart"])
            # Setup localization is optional: reject the partial attempt and keep the original boot.wim if packages conflict.
            self.run_cmd(["dism.exe", f"/Image:{mount}", "/Set-AllIntl:ru-RU"], check=False)
            self.run_cmd(["dism.exe", f"/Image:{mount}", "/Get-Intl"], check=False)
            self.run_cmd(["dism.exe", "/Unmount-Image", f"/MountDir:{mount}", "/Commit", "/CheckIntegrity"])
            self.mounts.remove(mount)
            return True
        except Exception as exc:
            try: self.run_cmd(["dism.exe", "/Unmount-Image", f"/MountDir:{mount}", "/Discard"], check=False, respect_cancel=False)
            except Exception: pass
            if mount in self.mounts: self.mounts.remove(mount)
            self.log(f"Не удалось локализовать Setup/WinPE; считаю это необязательным шагом и продолжаю с исходным boot.wim. Причина: {exc}")
            return False

    def validate_media_structure(self, media: Path) -> dict:
        sources = media / "sources"
        boot = sources / "boot.wim"
        install = list(sources.glob("install*.wim"))
        result = {"boot_wim": boot.is_file(), "install_wim": bool(install), "bios_boot_sector": (media / "boot" / "etfsboot.com").is_file(), "uefi_boot_sector": (media / "efi" / "microsoft" / "boot" / "efisys.bin").is_file(), "setup_exe": (media / "setup.exe").is_file()}
        self.log("Статическая проверка структуры ISO: " + json.dumps(result, ensure_ascii=False))
        if not result["boot_wim"] or not result["install_wim"] or not result["setup_exe"]:
            raise RuntimeError("После обработки не пройдена проверка структуры установочного носителя.")
        if not result["bios_boot_sector"] or not result["uefi_boot_sector"]:
            self.log("ПРЕДУПРЕЖДЕНИЕ: в исходном носителе не найдены оба стандартных загрузочных сектора BIOS/UEFI; проверьте итоговый ISO вручную.")
        return result

    def build_iso(self, media: Path) -> None:
        if not self.oscdimg:
            raise RuntimeError("Не найден oscdimg.exe. Установите Windows ADK (компонент Deployment Tools) и перезапустите программу. Исходный ISO сохранён.")
        bios = media / "boot" / "etfsboot.com"
        uefi = media / "efi" / "microsoft" / "boot" / "efisys.bin"
        if not bios.is_file() or not uefi.is_file():
            raise RuntimeError("В ISO не найдены оба файла загрузки BIOS и UEFI. Чтобы не потерять загрузочную совместимость, пересборка остановлена.")
        if self.cfg.output_iso.exists():
            raise RuntimeError("Файл выходного ISO уже существует. Выберите новое имя, чтобы программа не перезаписывала существующий файл.")
        bootdata = f"-bootdata:2#p0,e,b{bios}#pEF,e,b{uefi}"
        args = [self.oscdimg, "-m", "-o", "-u2", "-udfver102", bootdata, str(media), str(self.cfg.output_iso)]
        self.run_cmd(args)
        if not self.cfg.output_iso.is_file() or self.cfg.output_iso.stat().st_size < 1024 * 1024:
            raise RuntimeError("oscdimg не создал ожидаемый выходной ISO.")
        self.log(f"Создан итоговый ISO: {self.cfg.output_iso} ({human_bytes(self.cfg.output_iso.stat().st_size)})")
