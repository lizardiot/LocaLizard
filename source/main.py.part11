            self.drop_label.configure(text="Перетащите сюда ISO Windows")
        except Exception as exc:
            self.drop_label.configure(text=f"Не удалось подключить drag-and-drop ({exc}); выберите ISO через кнопку.")

    def _on_drop(self, event):
        try:
            items = self.tk.splitlist(event.data)
            iso = next((Path(x.strip('{}')) for x in items if Path(x.strip('{}')).suffix.lower() == '.iso'), None)
            if iso and iso.is_file():
                self.iso_var.set(str(iso))
                if not self.out_var.get():
                    self.out_var.set(str(iso.with_name(iso.stem + "_ru-RU.iso")))
                self.status_var.set(f"Выбран ISO: {iso}")
            else:
                messagebox.showwarning(APP_NAME, "Перетащите один файл с расширением .iso.")
        except Exception as exc:
            messagebox.showerror(APP_NAME, f"Не удалось обработать перетаскивание: {exc}")

    def _check_elevation(self):
        if is_windows() and not is_admin():
            messagebox.showinfo(APP_NAME, "Для обработки ISO программа должна быть запущена с правами администратора. Нажмите OK, чтобы запросить их.")
            if not elevate_or_exit(): self.destroy()
            else: self.destroy()

    def choose_iso(self):
        p = filedialog.askopenfilename(title="Выберите исходный ISO Windows", filetypes=[("ISO images", "*.iso"), ("All files", "*.*")])
        if p:
            self.iso_var.set(p)
            if not self.out_var.get(): self.out_var.set(str(Path(p).with_name(Path(p).stem + "_ru-RU.iso")))

    def choose_output(self):
        p = filedialog.asksaveasfilename(title="Куда сохранить итоговый ISO", defaultextension=".iso", filetypes=[("ISO images", "*.iso")])
        if p: self.out_var.set(p)

    def choose_work(self):
        p = filedialog.askdirectory(title="Выберите рабочую папку")
        if p: self.work_var.set(p)

    def choose_packages(self):
        p = filedialog.askdirectory(title="Папка с распакованными CAB языкового пакета ru-RU")
        if p: self.pack_var.set(p)

    def choose_fod(self):
        p = filedialog.askdirectory(title="Корень Language and Optional Features / FOD ISO")
        if p: self.fod_var.set(p)

    def check_uup(self):
        self.status_var.set("Проверяю UUP Dump API…")
        def run():
            try:
                url = UUP_API + "?" + urllib.parse.urlencode({"search": "Windows IoT Enterprise LTSC"})
                req = urllib.request.Request(url, headers={"User-Agent": f"{APP_NAME}/{APP_VERSION}"})
                with urllib.request.urlopen(req, timeout=15) as r:
                    data = json.loads(r.read().decode("utf-8", "replace"))
                builds = data.get("response", {}).get("builds", [])
                msg = f"UUP Dump API доступен. Получено записей сборок: {len(builds)}.\n\nВажно: это поиск обновлений/сборок, не гарантия наличия отдельного CAB ru-RU или FOD для вашего ISO. Совместимость всё равно проверяется DISM; не используйте неофициальные зеркала."
                self.events.put(("uup", msg))
            except Exception as e:
                self.events.put(("uup", f"Не удалось обратиться к UUP Dump API: {e}\nМожно продолжить, выбрав локальные языковые пакеты."))
        threading.Thread(target=run, daemon=True).start()
        webbrowser.open(UUP_SITE)

    def start(self):
        if self.worker_thread and self.worker_thread.is_alive(): return
        source = Path(self.iso_var.get().strip()) if self.iso_var.get().strip() else None
        output = Path(self.out_var.get().strip()) if self.out_var.get().strip() else None
        pack = Path(self.pack_var.get().strip()) if self.pack_var.get().strip() else (app_data_dir() / "Packages")
        fod = Path(self.fod_var.get().strip()) if self.fod_var.get().strip() else None
        work = Path(self.work_var.get().strip()) if self.work_var.get().strip() else None
        if not source or not source.is_file(): messagebox.showerror(APP_NAME, "Выберите существующий входной ISO."); return
        if not output: messagebox.showerror(APP_NAME, "Укажите имя итогового ISO."); return
        if not pack: pack = app_data_dir() / "Packages"
        if not work: messagebox.showerror(APP_NAME, "Выберите рабочую папку."); return
        if output.suffix.lower() != ".iso": messagebox.showerror(APP_NAME, "Выходной файл должен иметь расширение .iso."); return
        if not output.parent.is_dir(): messagebox.showerror(APP_NAME, "Папка для выходного ISO не существует."); return
        if output.exists(): messagebox.showerror(APP_NAME, "Выходной файл уже существует. Выберите другое имя, чтобы избежать случайной перезаписи."); return
        if source.resolve() == output.resolve(): messagebox.showerror(APP_NAME, "Входной и выходной ISO должны быть разными файлами."); return
        if fod and not fod.is_dir(): messagebox.showerror(APP_NAME, "Указанный каталог FOD не существует."); return
        free = shutil.disk_usage(work.parent if not work.exists() else work).free
        required = int(source.stat().st_size * 3.5 + 8 * 1024**3)
