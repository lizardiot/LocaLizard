APP_NAME = "LocaLizard"
APP_VERSION = "0.1.1"
UUP_API = "https://api.uupdump.net"
UUP_SITE = "https://uupdump.net/"
def _ll_uup_listid_url(search_term: str) -> str:
    """Build the documented UUP Dump build-list endpoint URL."""
    params = {"search": str(search_term or ""), "sortByDate": "1"}
    return UUP_API + "/listid.php?" + urllib.parse.urlencode(params)


def _ll_uup_response_body_builds(response) -> list:
    """Normalize listid.php results, including sparse PHP arrays encoded as JSON objects."""
    if not isinstance(response, dict):
        raise RuntimeError("UUP Dump вернул response не в виде объекта.")
    error = str(response.get("error", "") or "").strip().upper()
    if error:
        if error == "SEARCH_NO_RESULTS":
            return []
        raise RuntimeError(f"Ошибка UUP Dump API: {response.get('error')}")
    builds = response.get("builds")
    if isinstance(builds, list):
        rows = builds
    elif isinstance(builds, dict):
        # PHP encodes an array with non-contiguous numeric keys as a JSON object.
        # This happens after listid.php removes non-matching rows from a filtered result.
        rows = list(builds.values())
    else:
        raise RuntimeError("В ответе UUP Dump поле response.builds имеет неизвестный формат (ожидался массив или объект).")
    invalid = [index for index, item in enumerate(rows) if not isinstance(item, dict)]
    if invalid:
        raise RuntimeError(f"UUP Dump вернул некорректные элементы списка сборок (позиции: {', '.join(map(str, invalid[:5]))}).")
    return rows


def _ll_uup_response_body_files(response) -> list[tuple[str, dict]]:
    """Return only named file records with object metadata from get.php."""
    if not isinstance(response, dict):
        raise RuntimeError("UUP Dump вернул сведения о файлах не в виде объекта.")
    error = response.get("error")
    if error:
        raise RuntimeError(f"Ошибка UUP Dump при получении файлов: {error}")
    files = response.get("files", {})
    if isinstance(files, dict):
        rows = list(files.items())
    elif isinstance(files, list):
        rows = []
        for item in files:
            if not isinstance(item, dict):
                continue
            name = item.get("name") or item.get("filename") or item.get("fileName")
            if name:
                rows.append((str(name), item))
    else:
        raise RuntimeError("UUP Dump вернул files в неожиданном формате (ожидался объект или массив).")
    return [
        (str(name), metadata)
        for name, metadata in rows
        if isinstance(name, str) and isinstance(metadata, dict)
    ]


def _ll_uup_response_builds(data) -> list:
    """Extract a validated build list from a complete UUP Dump JSON response."""
    if not isinstance(data, dict):
        raise RuntimeError("UUP Dump вернул JSON не в виде объекта.")
    return _ll_uup_response_body_builds(data.get("response"))




def _ll_uup_listlangs_url(update_id: str) -> str:
    """Build the documented UUP Dump endpoint that lists languages for an update UUID."""
    return UUP_API + "/listlangs.php?" + urllib.parse.urlencode({"id": str(update_id or "").strip()})


def _ll_uup_response_body_langs(response) -> list[str]:
    """Normalize listlangs.php response into lowercase culture tags."""
    if not isinstance(response, dict):
        raise RuntimeError("UUP Dump вернул список языков не в виде объекта.")
    error = str(response.get("error", "") or "").strip()
    if error:
        raise RuntimeError(f"Ошибка UUP Dump при получении списка языков: {error}")
    languages = response.get("langList")
    if isinstance(languages, dict):
        languages = list(languages.values())
    if not isinstance(languages, (list, tuple)):
        raise RuntimeError("UUP Dump вернул langList в неожиданном формате.")
    return sorted({
        str(language).strip().lower()
        for language in languages
        if isinstance(language, str) and str(language).strip()
    })


def _ll_uup_is_install_build(item) -> bool:
    """Reject servicing updates; keep actual versioned Windows installation builds."""
    if not isinstance(item, dict):
        return False
    title = str(item.get("title", "") or "").strip().lower()
    if not title or "version" not in title:
        return False
    if not any(product in title for product in ("windows 10", "windows 11")):
        return False
    servicing_markers = (
        "critical oobe", "oobe update", "security update", "cumulative update",
        "servicing stack", "dynamic update", "update for microsoft",
        "update for windows", "enablement package", "hotpatch",
    )
    return not any(marker in title for marker in servicing_markers)


def _ll_uup_is_unsupported_combination(exc: Exception) -> bool:
    """UUP Dump uses this HTTP 400 code for UUID/language pairs it cannot generate."""
    return "UNSUPPORTED_COMBINATION" in str(exc).upper()

# Microsoft IoT Enterprise LTSC releases and their OS build families.
_LL_UUP_IOT_LTSC_FAMILIES = (
    ("Windows 11 IoT Enterprise LTSC 2024", 26100),
    ("Windows 10 IoT Enterprise LTSC 2021", 19044),
    ("Windows 10 IoT Enterprise LTSC 2019", 17763),
    ("Windows 10 IoT Enterprise LTSC 2016", 14393),
    ("Windows 10 IoT Enterprise LTSC 2015", 10240),
)


def _ll_uup_item_build_family(item) -> int | None:
    if not isinstance(item, dict):
        return None
    raw = str(item.get("build", "")).strip()
    numbers = re.findall(r"[0-9]+", raw)
    if not numbers:
        return None
    if raw.startswith("10.0.") and len(numbers) >= 3:
        return int(numbers[2])
    return int(numbers[0])


def _ll_uup_build_key(value) -> tuple[int, int] | None:
    """Normalize a DISM or UUP build string to (OS family, revision)."""
    raw = str(value or "").strip()
    numbers = [int(x) for x in re.findall(r"[0-9]+", raw)]
    if raw.startswith("10.0.") and len(numbers) >= 3:
        numbers = numbers[2:]
    if not numbers:
        return None
    return numbers[0], numbers[1] if len(numbers) > 1 else 0


def _ll_uup_is_client_build(item, family: int) -> bool:
    """Keep Windows client builds for IoT LTSC; reject Server and Azure Stack HCI."""
    if not isinstance(item, dict):
        return False
    title = str(item.get("title", "") or "").strip().lower()
    if not title:
        return False
    if any(marker in title for marker in (
        "server", "azure stack", "azurestack", "hci",
    )):
        return False
    expected_product = "windows 11" if family >= 22000 else "windows 10" if family >= 10240 else ""
    return bool(expected_product and expected_product in title)


def _ll_uup_diagnostic_report(fetch_builds) -> str:
    """Query each known IoT Enterprise LTSC build family independently."""
    lines = ["Проверка семейств Windows IoT Enterprise LTSC в UUP Dump:"]
    successful_queries = 0
    errors = []
    for release_name, family in _LL_UUP_IOT_LTSC_FAMILIES:
        try:
            builds = fetch_builds(str(family))
            if not isinstance(builds, list):
                raise RuntimeError("UUP Dump вернул неожиданный формат списка сборок.")
            matching = [
                item for item in builds
                if _ll_uup_item_build_family(item) == family
                and _ll_uup_is_client_build(item, family)
                and _ll_uup_is_install_build(item)
            ]
            architectures = sorted({
                str(item.get("arch", "")).strip()
                for item in matching
                if isinstance(item, dict) and str(item.get("arch", "")).strip()
            })
            line = f"- {release_name} (сборка {family}): {len(matching)} записей"
            if architectures:
                line += f"; архитектуры: {', '.join(architectures)}"
            elif not matching:
                line += "; в каталоге UUP Dump записи этой сборки не найдены"
            lines.append(line)
            successful_queries += 1
        except Exception as exc:
            lines.append(f"- {release_name} (сборка {family}): ошибка запроса — {exc}")
            errors.append(f"{family}: {exc}")
    if successful_queries == 0:
        raise RuntimeError("Не удалось получить данные ни для одного семейства LTSC. " + " | ".join(errors))
    if errors:
        lines.append("Некоторые запросы не выполнены; остальные результаты получены успешно.")
    lines.extend([
        "",
        "UUP Dump содержит не все исторические выпуски. Нулевой результат для старой ветки не означает, "
        "что ISO не поддерживается: используйте совместимый донорский ISO или локальный пакет, если этой ветки нет в UUP.",
        "Совместимость Client Language Pack и FOD с выбранным образом окончательно проверяется DISM."
    ])
    return "\n".join(lines)


# Official Microsoft ADK bootstrap (Deployment Tools only; downloaded on demand).
