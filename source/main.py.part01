def app_data_dir() -> Path:
    root = Path(os.environ.get("LOCALAPPDATA", Path.home() / "AppData" / "Local"))
    return root / "LocaLizard"
DOCS_LANG = "https://learn.microsoft.com/windows-hardware/manufacture/desktop/add-language-packs-to-windows?view=windows-11"
DOCS_FOD = "https://learn.microsoft.com/windows-hardware/manufacture/desktop/languages-overview?view=windows-11"
DOCS_ADK = "https://learn.microsoft.com/windows-hardware/get-started/adk-install"


def is_windows() -> bool:
    return os.name == "nt"


def is_admin() -> bool:
    try:
        return bool(ctypes.windll.shell32.IsUserAnAdmin())
    except Exception:
        return False


def elevate_or_exit() -> bool:
    """Relaunch elevated. Returns True if the current process is elevated."""
    if not is_windows() or is_admin():
        return True
    try:
        params = subprocess.list2cmdline(sys.argv)
        rc = ctypes.windll.shell32.ShellExecuteW(None, "runas", sys.executable, params, None, 1)
        if rc <= 32:
            messagebox.showerror(APP_NAME, "Не удалось запросить права администратора. Запустите программу от имени администратора.")
        return False
    except Exception as exc:
        try:
            messagebox.showerror(APP_NAME, f"Не удалось запросить права администратора:\n{exc}")
        except Exception:
            pass
        return False


def safe_size(path: Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


def find_oscdimg() -> str | None:
    candidates = []
    pf86 = os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")
    pf = os.environ.get("ProgramFiles", r"C:\Program Files")
    roots = [
        Path(pf86) / "Windows Kits" / "10" / "Assessment and Deployment Kit" / "Deployment Tools",
        Path(pf) / "Windows Kits" / "10" / "Assessment and Deployment Kit" / "Deployment Tools",
        app_data_dir() / "ADK",
        app_data_dir() / "ADK" / "Deployment Tools",
    ]
    for root in roots:
        if root.exists():
            candidates += list(root.glob("*/Oscdimg/oscdimg.exe"))
            candidates += list(root.glob("Oscdimg/oscdimg.exe"))
            # The ADK install path may vary slightly between kit releases.
            try:
                candidates += list(root.rglob("oscdimg.exe"))
            except OSError:
                pass
    for p in candidates:
        if p.is_file():
            return str(p)
    return shutil.which("oscdimg")


def human_bytes(n: int) -> str:
    v = float(n)
    for unit in ("Б", "КиБ", "МиБ", "ГиБ", "ТиБ"):
        if v < 1024 or unit == "ТиБ":
            return f"{v:.1f} {unit}" if unit != "Б" else f"{int(v)} Б"
        v /= 1024
    return str(n)


def quote_cmd(args: list[str]) -> str:
    return subprocess.list2cmdline(args)


@dataclass
class RunConfig:
    source_iso: Path
    donor_iso: Path | None
    output_iso: Path
    package_root: Path
    fod_root: Path | None
    work_root: Path
    keep_work: bool
    process_setup: bool
    updates_root: Path | None = None
    split_wim: bool = False
    vm_test: bool = False


class Worker:
    def __init__(self, events: queue.Queue, cancel_event: threading.Event, cfg: RunConfig):
        self.events = events
        self.cancel_event = cancel_event
        self.cfg = cfg
        self.log_path: Path | None = None
        self.work: Path | None = None
        self.source_drive: str | None = None
        self.donor_setup_files: list[Path] = []
        self.mounts: list[Path] = []
        self.oscdimg = find_oscdimg()

    def emit(self, kind: str, payload: str = "") -> None:
        self.events.put((kind, payload))

    def log(self, message: str) -> None:
        line = f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}"
        self.emit("log", line)
        if self.log_path:
            self.log_path.parent.mkdir(parents=True, exist_ok=True)
            with self.log_path.open("a", encoding="utf-8") as f:
                f.write(line + "\n")

