        dist.mkdir(parents=True, exist_ok=False)
        iso_q = str(self.cfg.source_iso.resolve()).replace("'", "''")
        mounted = False
        try:
            # Explicit ISO type avoids relying on the Windows file association.
            self.powershell(f"Mount-DiskImage -StorageType ISO -ImagePath '{iso_q}' -ErrorAction Stop")
            mounted = True
            script = (
                "$img=Get-DiskImage -ImagePath '" + iso_q + "' -ErrorAction Stop; "
                "$vol=$img | Get-Volume -ErrorAction Stop | "
                "Where-Object { $_.DriveLetter } | Select-Object -First 1; "
                "if(-not $vol){throw 'ISO не получил букву диска'}; "
                "Write-Output ($vol.DriveLetter + ':')"
            )
            cp = self.powershell(script)
            letter_match = re.search(r"(?im)^\s*([A-Z]):?\s*$", (cp.stdout or "").strip())
            if not letter_match:
                raise RuntimeError("Windows подключила ISO, но не удалось определить букву его диска.")
            self.source_drive = letter_match.group(1).upper() + ":" + chr(92)
            self.log(f"ISO смонтирован как {self.source_drive}; исходный ISO не изменяется.")
            # Robocopy exit codes 0-7 are non-fatal; >=8 means failure.
            robocopy = self.run_cmd(["robocopy", self.source_drive, str(dist), "/E", "/COPY:DAT", "/DCOPY:DAT", "/A-:R", "/R:1", "/W:1", "/XJ", "/NFL", "/NDL", "/NP"], check=False)
            if robocopy.returncode >= 8:
                raise RuntimeError(f"Не удалось скопировать содержимое ISO (Robocopy {robocopy.returncode}).")
        finally:
            # Do not query or detach the image when the attach command failed.
            if mounted:
                try:
                    self.powershell(f"Dismount-DiskImage -ImagePath '{iso_q}' -ErrorAction SilentlyContinue", check=False, respect_cancel=False)
                except Exception as exc:
                    self.log(f"Не удалось отмонтировать ISO после обработки: {exc}")
            self.source_drive = None
        if not (dist / "sources" / "boot.wim").is_file():
            raise RuntimeError("Это не похоже на установочный ISO Windows: отсутствует sources\\boot.wim.")
        images = list((dist / "sources").glob("install*.wim")) + list((dist / "sources").glob("install*.esd"))
        if not images:
            raise RuntimeError("Не найден sources\\install.wim или install.esd. Разделённые install*.swm не поддерживаются.")
        if (dist / "sources" / "install.swm").exists():
            raise RuntimeError("Обнаружен разделённый install.swm. Этот формат пока не поддерживается — нужен ISO с install.wim/ESD.")
        return dist

    def image_info(self, image: Path) -> list[dict]:
        cp = self.run_cmd(["dism.exe", "/English", "/Get-WimInfo", f"/WimFile:{image}"], check=True)
        text = cp.stdout or ""
        blocks = re.split(r"(?=Index\s*:\s*\d+)", text)
        result = []
        for block in blocks:
            mi = re.search(r"Index\s*:\s*(\d+)", block)
            if not mi: continue
            name = re.search(r"Name\s*:\s*(.+)", block)
            desc = re.search(r"Description\s*:\s*(.+)", block)
            arch = re.search(r"Architecture\s*:\s*(.+)", block)
            ver = re.search(r"Version\s*:\s*(.+)", block)
            result.append({"index": int(mi.group(1)), "name": name.group(1).strip() if name else "", "description": desc.group(1).strip() if desc else "", "architecture": arch.group(1).strip() if arch else "", "version": ver.group(1).strip() if ver else ""})
        return result

    def esd_to_wim_if_needed(self, media: Path) -> list[Path]:
        sources = media / "sources"
        esds = sorted(sources.glob("install*.esd"))
        wims = sorted(sources.glob("install*.wim"))
        if not wims and not esds:
            raise RuntimeError("Не найден install.wim/install.esd.")
        # Every install image is processed; ESD containers are exported without dropping indexes.
        for esd in esds:
            match = re.match(r"^(install.*)\.esd$", esd.name, re.I)
            wim = sources / ((match.group(1) if match else "install") + ".wim")
            infos = self.image_info(esd)
            if not infos: raise RuntimeError(f"DISM не обнаружил индексы внутри {esd.name}.")
            self.log(f"Преобразование {esd.name} в WIM: найдено индексов {len(infos)}.")
            if wim.exists():
                raise RuntimeError(f"Нельзя безопасно преобразовать {esd.name}: уже существует {wim.name}.")
            for info in infos:
                self.check_cancel()
                args = ["dism.exe", "/Export-Image", f"/SourceImageFile:{esd}", f"/SourceIndex:{info['index']}", f"/DestinationImageFile:{wim}", f"/DestinationName:{info['name'] or 'Windows image ' + str(info['index'])}", "/Compress:max", "/CheckIntegrity"]
                self.run_cmd(args)
            self.image_info(wim)
            esd.unlink()
            self.log(f"{esd.name} успешно преобразован в {wim.name}; индексы проверены.")
            wims.append(wim)
        # Remove duplicates and return each image container.
        result = sorted({p.resolve(): p for p in wims}.values())
        return result

    def locate_ru_lp(self, image_info: dict, candidates: list[Path]) -> Path | None:
        """Find a Russian client language pack by language/type/architecture, not commercial SKU name.

        Compatible Windows Enterprise/Pro/Education client language packs may also be used with
        Windows IoT Enterprise because the client OS base is shared. The servicing engine (DISM)
        is still the final compatibility check for the exact version/build and package metadata.
        """
        architecture = self.arch_token(image_info.get("architecture", ""))
        exact = []
        for p in candidates:
            n = p.name.lower()
            if p.suffix.lower() != ".cab" or "ru-ru" not in n:
                continue
            # Accept both explicit client LP names and generic language-pack names used by UUP sets.
            # Do not mistake FOD, LXP, WinPE, recovery, setup or Server CABs for a base LP.
            has_lp_marker = any(token in n for token in (
                "client-language-pack", "client-languagepack", "clientlanguagepack",
                "language-pack", "languagepack"
            ))
            if not has_lp_marker:
                continue
            if any(token in n for token in (
                "server", "winpe", "setup", "recovery", "languagefeatures", "local-experience-pack"
            )):
                continue
            if architecture == "arm64":
                arch_match = "arm64" in n
            elif architecture == "x86":
                arch_match = any(token in n for token in ("_x86_", "-x86-", "~x86~")) and not any(token in n for token in ("x86_64", "x86-64"))
            else:
                arch_match = any(token in n for token in ("_x64_", "_amd64_", "x86_64", "amd64", "x64"))
            if arch_match:
                exact.append(p)
        # Stable order makes selection deterministic if the catalog contains multiple matching CABs.
        return sorted(exact, key=lambda p: (0 if "client-language-pack" in p.name.lower() else 1, p.name.lower()))[0] if exact else None


    @staticmethod
    def classify_donor_package(path: Path) -> str | None:
        """Classify recognizable Russian CABs in a donor ISO.

        Generic sources/langpacks/ru-ru/lp.cab belongs to Setup, not necessarily to
        the installed client OS, so it must not be treated as the base client LP.
        """
        if path.suffix.lower() != ".cab":
            return None
        name = path.name.lower()
        normalized = str(path).replace("\\", "/").lower()
        if name == "lp.cab" and "/langpacks/ru-ru/" in normalized:
            return "setup"
        if "ru-ru" in name and any(token in name for token in ("winpe-setup", "winpe-rejuv")):
            return "setup"
        fod_tokens = (
            "languagefeatures-basic", "languagefeatures-ocr", "languagefeatures-speech",
            "languagefeatures-texttospeech", "languagefeatures-text-to-speech",
            "languagefeatures-handwriting",
        )
        if "ru-ru" in name and any(token in name for token in fod_tokens):
            return "fod"
        lp_markers = (
            "client-language-pack", "client-languagepack", "clientlanguagepack",
            "language-pack", "languagepack",
        )
        forbidden = ("server", "winpe", "setup", "recovery", "languagefeatures", "local-experience-pack")
        if "ru-ru" in name and any(token in name for token in lp_markers) and not any(token in name for token in forbidden):
            return "client_lp"
        return None
