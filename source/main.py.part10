        ttk.Label(header, text=APP_NAME, font=("Segoe UI", 18, "bold")).pack(anchor="w")
        header_subtitle = ttk.Label(header, text="Подготовка русифицированного ISO / WIM Windows", font=("Segoe UI", 10))
        header_subtitle.pack(anchor="w", pady=(2, 8))
        self._register_responsive_text(header_subtitle, 0.70, 220, 760)

        files = ttk.LabelFrame(root, text="1. Образы", padding=10)
        files.pack(fill="x", pady=4)
        self.iso_var = tk.StringVar()
        self.out_var = tk.StringVar()
        self.work_var = tk.StringVar(value=str(Path.home() / "IoTLTSC_Russianizer_Work"))
        self._file_row(files, 0, "Входной ISO Windows:", self.iso_var, self.choose_iso)
        self._file_row(files, 1, "Итоговый ISO:", self.out_var, self.choose_output)
        self._file_row(files, 2, "Рабочая папка:", self.work_var, self.choose_work)
        self.drop_label = ttk.Label(files, text="Перетащите сюда файл ISO (если поддерживается оболочкой)", anchor="center", relief="ridge", padding=9)
        self.drop_label.grid(row=3, column=0, columnspan=3, sticky="ew", pady=(8, 0))
        self._register_responsive_text(self.drop_label, 0.94, 260, 1000)
        files.columnconfigure(1, weight=1)

        packs = ttk.LabelFrame(root, text="2. Языковые компоненты ru-RU", padding=10)
        packs.pack(fill="x", pady=4)
        self.donor_iso_var = tk.StringVar()
        self.pack_var = tk.StringVar(value=str(app_data_dir() / "Packages"))
        self.fod_var = tk.StringVar()
        self.updates_var = tk.StringVar()
        self._file_row(packs, 0, "Русский ISO-источник (необязательно):", self.donor_iso_var, self.choose_donor_iso)
        self._file_row(packs, 1, "Кэш языковых пакетов (автозагрузка):", self.pack_var, self.choose_packages, directory=True)
        self._file_row(packs, 2, "FOD: каталог или ISO Language and Optional Features:", self.fod_var, self.choose_fod, directory=True)
        self._file_row(packs, 3, "Обновления: каталог с updates.json (необязательно):", self.updates_var, self.choose_updates, directory=True)
        self.donor_drop_label = ttk.Label(
            packs,
            text="Перетащите сюда донорский ISO с русским языком (необязательно)",
            anchor="center",
            relief="ridge",
            padding=9,
        )
        self.donor_drop_label.grid(row=4, column=0, columnspan=3, sticky="ew", pady=(8, 0))
        self._register_responsive_text(self.donor_drop_label, 0.94, 260, 1000)
        source_note = ttk.Label(
            packs,
            text="Для checkpoint cumulative updates и актуального LCU используйте совместимые официальные MSU/CAB и манифест updates.json. Русский ISO служит источником отдельных CAB и Setup-ресурсов, если его сборка соответствует цели.",
        )
        source_note.grid(row=5, column=0, columnspan=3, sticky="ew", pady=(5, 0))
        self._register_responsive_text(source_note, 0.94, 260, 1000)
        packs.columnconfigure(1, weight=1)

        opts = ttk.LabelFrame(root, text="3. Обработка и проверки", padding=10)
        opts.pack(fill="x", pady=4)
        self.keep_var = tk.BooleanVar(value=True)
        self.setup_var = tk.BooleanVar(value=True)
        self.split_var = tk.BooleanVar(value=False)
        self.vm_test_var = tk.BooleanVar(value=False)
        ttk.Checkbutton(opts, text="Сохранять рабочие файлы\nдля диагностики", variable=self.keep_var).grid(row=0, column=0, sticky="w", padx=3, pady=2)
        ttk.Checkbutton(opts, text="Локализовать Windows Setup и\nWinPE при наличии WinPE Add-on", variable=self.setup_var).grid(row=0, column=1, sticky="w", padx=3, pady=2)
        ttk.Checkbutton(opts, text="Разбить итоговый install.wim\nна SWM для FAT32", variable=self.split_var).grid(row=1, column=0, sticky="w", padx=3, pady=2)
        ttk.Checkbutton(opts, text="Выполнить 120-секундный запуск\nISO в Hyper-V", variable=self.vm_test_var).grid(row=1, column=1, sticky="w", padx=3, pady=2)
        opts_note = ttk.Label(opts, text="WinRE локализуется из L&O ISO, если подходящий набор доступен. Hyper-V smoke-test требует Hyper-V/прав администратора и не распознаёт автоматически экран Setup.", foreground="#555")
        opts_note.grid(row=2, column=0, columnspan=2, sticky="ew", pady=(6, 0))
        self._register_responsive_text(opts_note, 0.94, 260, 1000)
        opts.columnconfigure(0, weight=1)
        opts.columnconfigure(1, weight=1)

        actions = ttk.Frame(root)
        actions.pack(fill="x", pady=(8, 5))
        actions.columnconfigure(0, weight=1)
        actions.columnconfigure(1, weight=1)
        self.start_btn = ttk.Button(actions, text="Проверить условия и создать ISO", command=self.start)
        self.start_btn.grid(row=0, column=0, sticky="ew", padx=3, pady=3)
        self.cancel_btn = ttk.Button(actions, text="Отменить", command=self.cancel, state="disabled")
        self.cancel_btn.grid(row=0, column=1, sticky="ew", padx=3, pady=3)
        ttk.Button(actions, text="Проверить UUP Dump", command=self.check_uup).grid(row=1, column=0, sticky="ew", padx=3, pady=3)
        ttk.Button(actions, text="Обработать существующий WIM…", command=self.patch_existing_wim).grid(row=1, column=1, sticky="ew", padx=3, pady=3)
        ttk.Button(actions, text="Документация Microsoft", command=lambda: webbrowser.open(DOCS_LANG)).grid(row=2, column=0, columnspan=2, sticky="ew", padx=3, pady=3)

        self.status_var = tk.StringVar(value="Готово к настройке. Ничего не будет изменено до нажатия кнопки запуска.")
        status_label = ttk.Label(root, textvariable=self.status_var)
        status_label.pack(fill="x", pady=(4, 3))
        self._register_responsive_text(status_label, 0.94, 260, 1000)
        self.progress = ttk.Progressbar(root, mode="indeterminate")
        self.progress.pack(fill="x", pady=(0, 6))
        self.log_text = tk.Text(logs_frame, height=10, wrap="word", state="disabled", font=("Consolas", 9))
        scroll = ttk.Scrollbar(logs_frame, orient="vertical", command=self.log_text.yview)
        self.log_text.configure(yscrollcommand=scroll.set)
        self.log_text.pack(side="left", fill="both", expand=True)
        scroll.pack(side="right", fill="y")

        footer = ttk.Label(root, text="Windows 10/11 x64 и интернет нужны для автоматической загрузки компонентов, если пакеты не найдены в русском ISO или локальном кэше. При отсутствии oscdimg программа сама загрузит официальный ADK и установит Deployment Tools в свой каталог. Оригинальный ISO не изменяется.", foreground="#555")
        footer.pack(fill="x", pady=(4, 0))
        self._register_responsive_text(footer, 0.94, 260, 1000)

    def _file_row(self, parent, row, label, var, command, directory=False):
        label_widget = ttk.Label(parent, text=label)
        label_widget.grid(row=row, column=0, sticky="w", padx=(0, 10), pady=3)
        self._register_responsive_text(label_widget, 0.40, 150, 360)
        ttk.Entry(parent, textvariable=var, width=14).grid(row=row, column=1, sticky="ew", pady=3)
        ttk.Button(parent, text="Выбрать…", command=command).grid(row=row, column=2, padx=(8, 0), pady=3)

    def _try_enable_dnd(self):
        if DND_FILES is None:
            message = "Перетаскивание недоступно в этой сборке; выберите ISO через кнопку «Выбрать…»."
            self.drop_label.configure(text=message)
            self.donor_drop_label.configure(text=message)
            return
        try:
            self.drop_label.drop_target_register(DND_FILES)
            self.drop_label.dnd_bind("<<Drop>>", self._on_drop)
            self.donor_drop_label.drop_target_register(DND_FILES)
            self.donor_drop_label.dnd_bind("<<Drop>>", self._on_donor_drop)
